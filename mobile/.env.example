# URL da API, sempre terminando em /api/v1. No celular, use o IP do computador (ipconfig), não localhost.
# API real (backend no Docker):
EXPO_PUBLIC_API_URL=http://192.168.0.15:3000/api/v1
# Mock do openapi.yaml (npm run mock):
# EXPO_PUBLIC_API_URL=http://192.168.0.15:4010/api/v1

# Serviços falsos enquanto a rota não existe, separados por vírgula (vazio = todos reais).
# Nomes aceitos: getHealth
EXPO_PUBLIC_FAKE_SERVICES=
