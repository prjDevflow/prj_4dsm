# Servidor
PORT=3000
# development | test | production
NODE_ENV=development
# Lista separada por vírgula
CORS_ORIGINS=http://localhost:8081
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Banco local do docker compose (só para desenvolvimento; troque a senha no seu .env)
POSTGRES_USER=access
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=access
# Porta do PostgreSQL no seu computador (mude se já houver um Postgres na 5432)
DB_PORT=5432
# Conexão usada fora do Docker (npm run dev, db:migrate). Mantenha usuário, senha e porta iguais aos acima.
# No docker compose a API recebe a URL do serviço db sozinha; não use este valor em produção.
DATABASE_URL=postgresql://access:troque-esta-senha@localhost:5432/access

# Seed de desenvolvimento (npm run db:seed ou docker compose run --rm seed).
# ATENÇÃO: estes valores são PÚBLICOS (estão no repositório) e servem só para desenvolvimento.
# O seed se recusa a rodar com NODE_ENV=production, a menos que SEED_ALLOW_PRODUCTION=true.
SEED_ADMIN_EMAIL=admin@dev.local
SEED_ADMIN_PASSWORD=Admin-Dev-2026
# Senha do condômino e do visitante de teste (condomino@dev.local e visitante@dev.local)
SEED_USER_PASSWORD=Usuario-Dev-2026
# Chave do terminal de desenvolvimento (mínimo 32 caracteres); o banco guarda só o SHA-256
SEED_TERMINAL_KEY=terminal-dev-key-1234567890abcdef1234567890
# Local de testes (padrão: exemplo do doc 03). Troque pelas coordenadas reais da catraca.
SEED_LATITUDE=-23.30512
SEED_LONGITUDE=-45.96551

# Autenticação (B05)
# Segredo que assina os tokens JWT, no mínimo 32 caracteres (o valor abaixo é curto de propósito: a API não sobe até você trocá-lo).
# Gere um com: openssl rand -base64 48
# Quem tem o segredo emite token de qualquer usuário: nunca o versione e use um valor diferente em cada ambiente.
JWT_SECRET=troque-este-segredo
# Validade do token: número inteiro + s, m, h ou d (padrão 12h)
JWT_EXPIRES_IN=12h
# Custo do bcrypt, de 4 a 15 (padrão 10). Também vale para o seed.
BCRYPT_COST=10
# Tentativas de login por minuto para cada combinação de IP e e-mail (padrão 5)
LOGIN_MAX_PER_MINUTE=5
