# Servidor
PORT=3000
# development | test | production
NODE_ENV=development
# Lista separada por vírgula
CORS_ORIGINS=http://localhost:8081
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Banco local do docker compose (só para desenvolvimento; troque a senha no seu .env)
POSTGRES_USER=access
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=access
# Porta do PostgreSQL no seu computador (mude se já houver um Postgres na 5432)
DB_PORT=5432
